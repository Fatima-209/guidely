# Set to production for production security defaults.
GUIDELY_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated verified addresses allowed to administer documents.
ADMIN_EMAILS=polytechnic.main@outlook.com
# Disable guest access in production unless you explicitly need shared read-only access.
ALLOW_GUEST_LOGIN=1
# Set to 1 when serving over HTTPS.
AUTH_COOKIE_SECURE=0
# Required in production; generate a unique random value and keep it secret.
AUTH_CODE_SECRET=
# Email delivery (SMTP). Leave SMTP_HOST blank for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Guidely <no-reply@example.com>"
SMTP_STARTTLS=1
SMTP_SSL=0
REQUIRE_OPENAI_API=0
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GUIDELY_DB=backend/data/guidely.sqlite3
