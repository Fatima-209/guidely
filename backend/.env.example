# Set to production for production security defaults.
GUIDELY_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated trusted addresses allowed to administer documents.
ADMIN_EMAILS=polytechnic.main@outlook.com
# Required when creating an administrator account; choose a private value and enter it in the sign-up form.
ADMIN_SIGNUP_KEY=
# Disable guest access in production unless you explicitly need shared read-only access.
ALLOW_GUEST_LOGIN=1
# Set to 1 when serving over HTTPS.
AUTH_COOKIE_SECURE=0
# Keep lax for same-origin deployments.
AUTH_COOKIE_SAMESITE=lax
REQUIRE_OPENAI_API=0
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GUIDELY_DB=backend/data/guidely.sqlite3
